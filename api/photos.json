layout: null
---
{% assign all_photos = site.pages | where_exp:"asset", "asset.path contains 'photos/'" | where_exp:"asset", "asset.image" | sort: 'date' | reverse  %}
[
    {% for photo in all_photos %}{ date: "{{ asset.date }}", url: "{{site.baseurl}}{{asset.url}}/../{{ asset.image }}", palette: "{%if asset.palette %}{{asset.palette}}{% else %}?{% endif %}" },
    {% endfor %}
]